{
  "name": "options-radar-ar",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:server\" \"npm:client\"",
    "server": "node server/index.js",
    "client": "vite --host 0.0.0.0",
    "build": "vite build",
    "start": "node server/index.js",
    "android:init": "npx cap add android",
    "android:sync": "npm run build && npx cap sync android",
    "android:open": "npx cap open android",
    "android:prepare": "npm run build && (test -d android || npx cap add android) && npx cap sync android",
    "test": "node --test"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "vite": "latest",
    "react": "latest",
    "react-dom": "latest",
    "express": "latest",
    "cors": "latest",
    "concurrently": "latest",
    "lucide-react": "latest",
    "@capacitor/core": "latest",
    "@capacitor/android": "latest",
    "lightweight-charts": "^5.0.0",
    "technicalindicators": "^3.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "latest"
  }
}
