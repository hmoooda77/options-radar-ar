{
  "name": "options-radar-ar",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:server\" \"npm:client\"",
    "server": "node server/index.js",
    "client": "vite --host 0.0.0.0",
    "build": "vite build",
    "start": "node server/index.js",
    "android:init": "npx cap add android",
    "android:sync": "npm run build && npx cap sync android",
    "android:open": "npx cap open android",
    "android:prepare": "npm run build && (test -d android || npx cap add android) && npx cap sync android",
    "test": "node --test"
  },
  "dependencies": {
    "@vitejs/plugin-react": "4.3.4",
    "vite": "4.5.14",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "express": "4.21.2",
    "cors": "2.8.5",
    "concurrently": "8.2.2",
    "lucide-react": "0.468.0",
    "@capacitor/core": "5.7.8",
    "@capacitor/android": "5.7.8",
    "lightweight-charts": "5.0.0",
    "technicalindicators": "3.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "5.7.8"
  }
}
